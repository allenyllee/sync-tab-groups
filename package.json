{
  "name": "sync-tab-groups",
  "version": "1.0.0",
  "description": "Packages necessary for compiling the project.",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:build-assets",
    "test:build-assets": "rimraf build/chrome && npm run build:chrome && node --test scripts/build-assets.test.cjs",
    "test:brave": "npm run build:chrome && node scripts/brave-regression.test.cjs",
    "test:jasmine:unit": "npm run build:chrome && node scripts/brave-jasmine.test.cjs unit",
    "test:jasmine:integration": "npm run build:chrome && node scripts/brave-jasmine.test.cjs integration",
    "test:regression": "npm test && npm run test:jasmine:unit && npm run test:jasmine:integration && npm run test:brave",
    "build": "rimraf build && npm run build:firefox && npm run build:chrome",
    "build:firefox": "webpack --mode development --env browser=firefox --progress",
    "build:chrome": "webpack --mode development --env browser=chrome --progress",
    "watch": "npm run build:firefox -- --watch",
    "build:prod": "rimraf release && npm run build:prod:firefox && npm run build:prod:chrome",
    "build:prod:firefox": "webpack --mode production --env browser=firefox --progress",
    "build:prod:chrome": "webpack --mode production --env browser=chrome --progress",
    "release": "npm run build:prod && npm run zip",
    "zip": "cd release/firefox && zip -r ../sync-tab-groups-firefox.xpi * && cd ../chrome && zip -r ../sync-tab-groups-chrome.zip * && cd ../../",
    "clean": "rimraf build release",
    "lint": "npx eslint extension --quiet",
    "firefox:prod": "npx web-ext run --sourceDir=release/firefox",
    "firefox:dev": "npx web-ext run --sourceDir=build/firefox"
  },
  "dependencies": {
    "css-loader": "^7.1.2",
    "font-awesome": "^4.7.0",
    "sass": "^1.32.0",
    "sass-loader": "^16.0.5",
    "web-ext": "^10.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.0",
    "acorn": "^6.0.3",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "babel-eslint": "^10.0.1",
    "babel-loader": "^10.0.0",
    "classnames": "^2.2.6",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^5.8.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jasmine": "^2.10.1",
    "eslint-plugin-jsdoc": "^3.9.1",
    "eslint-plugin-react": "^7.11.1",
    "immutable": "^3.8.2",
    "jasmine": "^2.99.0",
    "jasmine-core": "^2.99.1",
    "mark.js": "^8.11.1",
    "mini-css-extract-plugin": "^2.9.4",
    "prop-types": "^15.6.2",
    "react": "^16.6.0",
    "react-dom": "^16.6.0",
    "react-redux": "^5.1.0",
    "redux": "^4.2.1",
    "rimraf": "^3.0.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "webextension-polyfill": "^0.10.0",
    "webpack": "^5.100.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1",
    "ws": "^8.21.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morikko/sync-tab-groups.git"
  },
  "author": "Morikko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Morikko/sync-tab-groups/issues"
  },
  "homepage": "https://github.com/Morikko/sync-tab-groups/blob/master/README.md"
}
