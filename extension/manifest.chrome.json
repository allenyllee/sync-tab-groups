{
  "manifest_version": 3,
  "version": "1.0.0",
  "name": "Tab Groups Resurrection",
  "description": "__MSG_extension_description__",
  "homepage_url": "https://github.com/allenyllee/sync-tab-groups",
  "icons": {
    "128": "/share/icons/tab-groups-resurrection-128.png",
    "64": "/share/icons/tab-groups-resurrection-64.png",
    "32": "/share/icons/tab-groups-resurrection-32.png",
    "16": "/share/icons/tab-groups-resurrection-16.png"
  },
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "storage",
    "sessions",
    "downloads",
    "notifications",
    "contextMenus",
    "unlimitedStorage",
    "alarms"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "/share/icons/tab-groups-resurrection-16.png",
      "32": "/share/icons/tab-groups-resurrection-32.png"
    },
    "default_title": "Tab Groups Resurrection",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "/options/option-page.html",
    "open_in_tab": true
  },
  "default_locale": "en",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "MacCtrl+Shift+Space"
      },
      "description": "Open Menu"
    },
    "swtich_next_group": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "Switch Next Group"
    },
    "swtich_previous_group": {
      "suggested_key": {
        "default": "Alt+Shift+Left"
      },
      "description": "Switch Previous Group"
    },
    "remove_group_swtich": {
      "suggested_key": {
        "default": "Alt+Shift+Delete"
      },
      "description": "Remove current group"
    }
  }
}
